GOOGLE_API_KEY=""

# Global compatibility fallback. Role-specific values take precedence when set.
ADK_MODEL="gemini-3.5-flash-lite"
ADK_MODEL_ROUTER="gemini-3.5-flash"
ADK_MODEL_REASONING="gemini-3.5-flash"
ADK_MODEL_WORKER="gemini-3.5-flash-lite"
ADK_MODEL_FINALIZER="gemini-3.5-flash"
ADK_MODEL_FALLBACK="gemini-3.5-flash-lite"

ADK_MODEL_RETRY_ATTEMPTS="4"
ADK_MODEL_RETRY_INITIAL_DELAY_SECONDS="1"
ADK_MODEL_RETRY_MAX_DELAY_SECONDS="8"
ADK_MODEL_RETRY_EXPONENTIAL_BASE="2"
ADK_MODEL_RETRY_JITTER_SECONDS="1"

ADK_WORKSPACE_ENABLED="true"
ADK_WORKSPACE_MODE="strict"

ADK_TASK_PLAN_ROOT="data/task_plans"
ADK_TASK_PLAN_MAX_BYTES="262144"
ADK_USER_PROFILE_PATH="config/user-profile.json"

# Kev public Space. Optional token is read only from the named environment variable.
ADK_MCP_SERVERS='[{"name":"kev","transport":"streamable_http","url":"https://jaredpalmer-kev.hf.space/gradio_api/mcp/","bearer_token_env":"HF_TOKEN"}]'
# Opt in to sending task title/description/capabilities to the public Space.
# Results are observational only; deterministic dispatch remains authoritative.
ADK_KEV_SHADOW_ENABLED="false"
HF_TOKEN=""
